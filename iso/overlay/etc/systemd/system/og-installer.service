[Unit]
Description=OG-Host installer
ConditionKernelCommandLine=og.installer
After=systemd-user-sessions.service plymouth-quit-wait.service systemd-networkd.service
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
ExecStart=/usr/local/bin/og-hostd installer
Restart=on-failure
RestartSec=3
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Environment=TERM=linux

[Install]
WantedBy=multi-user.target
